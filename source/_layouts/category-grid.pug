extends includes/layout.pug

block content
  #novel-grid-wrap
    h1#novel-grid-title= page.categoryName
    #recent-posts.recent-posts.nc.novel-grid
      .recent-post-items
        each article in page.posts
          - const link = article.link || article.path
          - const title = article.title || _p('no_title')
          .recent-post-item.novel-grid-item
            .recent-post-info.no-cover
              a.article-title(href=url_for(link) title=title)= title
